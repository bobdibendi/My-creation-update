{
  "name": "cursor-clone-license-generator",
  "productName": "My Creation License Generator",
  "version": "1.1.0",
  "description": "GÃ©nÃ©rateur de licences JWT RS256 pour My Creation (outil admin local).",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:127.0.0.1:5174 && electron . --dev\"",
    "dev:renderer": "vite",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json && node scripts/postbuild.cjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false && tsc -p electron/tsconfig.json --noEmit --pretty false",
    "dist": "npm run build && electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.cursorclone.licensegenerator",
    "productName": "My Creation License Generator",
    "copyright": "Copyright Â© 2026 My Creation. Tous droits rÃ©servÃ©s.",
    "artifactName": "${productName} Setup ${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": true,
    "compression": "maximum",
    "removePackageScripts": true,
    "removePackageKeywords": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/**/*.map",
      "package.json",
      "!**/{.DS_Store,.git,.gitignore,.gitattributes,.editorconfig,.eslintcache}",
      "!**/{__tests__,test,tests,powered-test,example,examples}",
      "!**/*.{md,markdown,ts,tsx,map,tsbuildinfo}",
      "!**/{tsconfig.json,tsconfig.*.json,vite.config.ts,eslint.config.mjs}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "License Generator",
      "legalTrademarks": "My Creation",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "selectPerMachineByDefault": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": false,
      "shortcutName": "My Creation License Generator",
      "uninstallDisplayName": "My Creation License Generator ${version}",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "runAfterFinish": false,
      "language": "1036",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp"
    }
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.46.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3"
  }
}
