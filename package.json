{
  "name": "cursor-clone",
  "productName": "My Creation",
  "version": "1.0.0",
  "description": "Éditeur de code assisté par IA : chat, agent autonome, prévisualisation et terminal intégrés.",
  "author": {
    "name": "My Creation"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:renderer\" \"wait-on tcp:127.0.0.1:5173 && node scripts/launch-electron.cjs dev\"",
    "dev:renderer": "vite",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json && node scripts/postbuild.cjs",
    "icons": "python scripts/generate-icons.py",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false && tsc -p electron/tsconfig.json --noEmit --pretty false",
    "lint": "eslint .",
    "start": "node scripts/launch-electron.cjs prod",
    "test": "node scripts/test.cjs",
    "test:providers": "node scripts/test.cjs providers",
    "test:runtime": "node scripts/test.cjs runtime",
    "test:renderer": "node scripts/test.cjs renderer",
    "test:app": "node scripts/test.cjs app",
    "test:agent": "node scripts/test.cjs agent",
    "test:dev": "node scripts/test-dev.cjs",
    "test:launch": "node scripts/test-launch.cjs",
    "test:package": "node scripts/test-package.cjs",
    "test:installer": "node scripts/test-installer.cjs",
    "check": "npm run typecheck && npm run lint && npm run build && npm test && npm run test:dev && npm run test:launch",
    "release": "npm run typecheck && npm run lint && npm run dist && npm run test:package && npm run test:installer"
  },
  "build": {
    "appId": "com.mycreation.desktop",
    "protocols": [
      {
        "name": "My Creation Auth",
        "schemes": [
          "mycreation"
        ]
      }
    ],
    "productName": "My Creation",
    "copyright": "Copyright © 2026 My Creation. Tous droits réservés.",
    "artifactName": "${productName} Setup ${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "compression": "maximum",
    "removePackageScripts": true,
    "removePackageKeywords": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/**/*.map",
      "package.json",
      "!**/{.DS_Store,.git,.gitignore,.gitattributes,.editorconfig,.eslintcache}",
      "!**/{__tests__,test,tests,powered-test,example,examples}",
      "!**/*.{md,markdown,ts,tsx,map,tsbuildinfo}",
      "!**/{tsconfig.json,tsconfig.*.json,vite.config.ts,eslint.config.mjs}"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "My Creation",
      "legalTrademarks": "My Creation",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "selectPerMachineByDefault": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": false,
      "shortcutName": "My Creation",
      "uninstallDisplayName": "My Creation ${version}",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "runAfterFinish": true,
      "language": "1036",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "license": "build/license.txt"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bobdibendi",
        "repo": "My-creation-update",
        "channel": "latest"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icons",
      "category": "Development"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^9.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.18.0",
    "framer-motion": "11.15.0",
    "globals": "15.14.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.46.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.6.2",
    "jsonwebtoken": "^9.0.3",
    "jsrsasign": "^11.1.5"
  }
}
